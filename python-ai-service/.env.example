# Copy this file to `.env` for local development:   copy .env.example .env
# `.env` is ignored by Git. Never put real keys in THIS file, and never
# send them to the React frontend.

# --- Service (optional overrides) -------------------------------------------
# APP_NAME=PublishPro-AI Python AI Service

# --- Text generation: Groq (captions and hashtags) --------------------------
# Put your real key in `.env`, not here.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

