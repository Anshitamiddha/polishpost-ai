# Copy this file to `.env` for local development:   copy .env.example .env
# `.env` is ignored by Git. Never put real keys in THIS file, and never
# send them to the React frontend.

# --- Service (optional overrides) -------------------------------------------
# APP_NAME=PublishPro-AI Python AI Service

# --- Login between Spring Boot and this service ------------------------------
# Spring Boot sends this value in the X-Internal-Service-Token header. Both
# sides must use the same one. Make a long random value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Put the real value in `.env`, not here. Empty means every request is refused.
AI_SERVICE_SHARED_SECRET=

# --- Thumbnails: Magic Hour ---------------------------------------------------
# Put your real key in `.env`, not here. Empty means thumbnail requests answer 503.
MAGIC_HOUR_API_KEY=
# These have working defaults. Uncomment only to change them.
# MAGIC_HOUR_IMAGE_MODEL=z-image-turbo
# MAGIC_HOUR_IMAGE_RESOLUTION=640px
# Longest wait for one picture, in seconds.
# MAGIC_HOUR_TIMEOUT_SECONDS=120
# Where finished thumbnails are saved. Default: the generated/thumbnails folder in this project.
# THUMBNAIL_OUTPUT_DIR=

# --- Storage: Backblaze B2 (S3-compatible) ------------------------------------
# Connection setup only for now. Put the real values in `.env`, not here.
# Check them with:  python -m app.services.b2_connection_check
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT_URL=
B2_REGION=
