# Spring Boot backend environment variables
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Keep this password out of source control. SSL is required by Supabase.
SUPABASE_DB_URL=
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=

# Use a random Base64-encoded secret of at least 32 bytes.
JWT_SECRET=replace_with_a_secure_base64_jwt_secret
JWT_EXPIRATION=900000

AI_SERVICE_SHARED_SECRET=

B2_APPLICATION_KEY=
B2_BUCKET_NAME=

B2_ENDPOINT_URL=
B2_REGION=