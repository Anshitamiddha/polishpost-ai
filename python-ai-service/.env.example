# Copy this file to `.env` for local development:   copy .env.example .env
# `.env` is ignored by Git. Never put real keys in THIS file, and never
# send them to the React frontend.

# --- Service (optional overrides) -------------------------------------------
# APP_NAME=PublishPro-AI Python AI Service

# --- Login between Spring Boot and this service ------------------------------
# Spring Boot sends this value in the X-Internal-Service-Token header. Both
# sides must use the same one. Make a long random value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Put the real value in `.env`, not here. Empty means every request is refused.
AI_SERVICE_SHARED_SECRET=

# --- Text generation: Groq (captions and hashtags) --------------------------
# Put your real key in `.env`, not here.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Image generation: Gemini (RESERVED for a later step) -------------------
# Nothing reads this yet.
# GEMINI_API_KEY=
